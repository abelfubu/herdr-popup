#!/usr/bin/env bash
set -euo pipefail

WIDTH="80%"
HEIGHT="80%"
FOCUS="--focus"
CWD=""
WAIT=""
CMD=""

usage() {
  cat <<'EOF'
Usage: herdr-popup [options] -- <command>

Options:
  -w, --width SIZE     Popup width (cells or %), default 80%
  -h, --height SIZE    Popup height (cells or %), default 80%
  -d, --cwd PATH       Working directory for the command
  -n, --no-focus       Do not focus the popup
  -k, --keep-open      Wait for a keypress after the command exits

Examples:
  herdr-popup -- glow README.md
  herdr-popup -d /path/to/repo -- nvim -c DiffviewOpen
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--width) WIDTH="$2"; shift 2 ;;
    -h|--height) HEIGHT="$2"; shift 2 ;;
    -d|--cwd) CWD="$2"; shift 2 ;;
    -n|--no-focus) FOCUS="--no-focus"; shift ;;
    -k|--keep-open) WAIT="1"; shift ;;
    --) shift; CMD="$*"; break ;;
    -*) usage ;;
    *) CMD="$*"; break ;;
  esac
done

if [[ -z "$CMD" ]]; then
  usage
fi

ENVS=()
ENVS+=(--env "HERDR_POPUP_CMD=$CMD")
[[ -n "$CWD" ]] && ENVS+=(--env "HERDR_POPUP_CWD=$CWD")
[[ -n "$WAIT" ]] && ENVS+=(--env "HERDR_POPUP_WAIT=1")

exec herdr plugin pane open \
  --plugin herdr-popup \
  --entrypoint popup \
  --placement popup \
  --width "$WIDTH" \
  --height "$HEIGHT" \
  "$FOCUS" \
  "${ENVS[@]}"
